{
  "name": "gdarena",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,VITE \"API_PORT=3001 node server/index.js\" \"vite --host 0.0.0.0 --port 3000 --strictPort\"",
    "build": "tsc -b && vite build",
    "check": "tsc --noEmit && node --check server/index.js && node --check server/llm.js && node --check server/_core/llm.js",
    "preview": "vite preview --host 0.0.0.0 --port 3000 --strictPort"
  },
  "dependencies": {
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
